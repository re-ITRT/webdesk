{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebDesk",
  "version": "0.2.1",
  "identifier": "com.webdesk.desktop",
  "build": {
    "frontendDist": "../src-frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix src-frontend run dev",
    "beforeBuildCommand": "npm --prefix src-frontend run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../src-frontend/dist": "webdesk/dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
